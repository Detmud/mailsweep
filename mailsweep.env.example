# Vorlage für die Env-Datei. Mit Komodo: Inhalt ins Stack-Feld "Environment",
# Passwörter als Secret-Variablen ([[NAME]]). Ohne Komodo: cp mailsweep.env.example .env

# --- iCloud IMAP -----------------------------------------------------------
# App-spezifisches Passwort: account.apple.com > Anmelden und Sicherheit >
# App-spezifische Passwörter. NICHT dein Apple-Account-Passwort.
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_USER=deine.adresse@icloud.com
IMAP_PASSWORD=abcd-efgh-ijkl-mnop

# Ordner, die analysiert werden (kommagetrennt). Für den Anfang reicht INBOX.
SCAN_FOLDERS=INBOX

# Leer lassen = automatisch erkennen (iCloud: "Archive" und "Deleted Messages")
ARCHIVE_FOLDER=
TRASH_FOLDER=

# --- Abmelden per mailto: (geht über smtp.mail.me.com mit demselben Passwort)
ALLOW_MAILTO_UNSUBSCRIBE=true
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
# Absenderadresse für Abmelde-Mails, leer = IMAP_USER
SMTP_FROM=

# Ausweich-DNS, falls dein DNS-Filter eine Abmelde-Domain blockt (z. B. r.openai.com).
# Wird nur genutzt, wenn du im Abmelde-Dialog ausdrücklich darauf klickst. Leer = aus.
UNSUB_FALLBACK_DNS=9.9.9.9

# Mailserver, deren Authentication-Results für die DKIM-Spalte zählen (Suffix-Vergleich, kommagetrennt)
TRUSTED_AUTHSERV_IDS=icloud.com

# --- Spamfilter (optional, lokal) ------------------------------------------
# Startet die Container für Rspamd und Redis mit. Ohne diese Zeile läuft nur mailsweep.
#COMPOSE_PROFILES=spam
# Bewertung einschalten (auch in der App unter Einstellungen änderbar)
SPAM_FILTER=false
# Ab diesem Score gilt eine Mail als Spam-Verdacht
SPAM_THRESHOLD=6
# Nur Mails der letzten N Tage bewerten, pro Sync höchstens SPAM_PER_SYNC Stück,
# pro Mail höchstens SPAM_MAX_KB vom Server laden (jede Bewertung lädt die Mail)
SPAM_MAX_AGE_DAYS=30
SPAM_PER_SYNC=300
SPAM_MAX_KB=512
RSPAMD_URL=http://rspamd:11333
# Anlernen (Bayes, ab 1.6.0): Passwort für den Rspamd-Controller, nur Buchstaben und Ziffern,
# z. B. `openssl rand -hex 24`. Bei Komodo als Secret: RSPAMD_PASSWORD=[[MAILSWEEP_RSPAMD_PASSWORD]]
# Leer = kein Anlernen, der Controller bleibt aus.
RSPAMD_PASSWORD=
# Anlernen an/aus (auch in der App), höchstens so viele Mails pro Aktion bzw. pro Sync
SPAM_LEARN=true
SPAM_LEARN_MAX=100
# Score-Regel: Mails ab SPAM_AUTO_SCORE nach jedem Sync automatisch in den Papierkorb (auch in der App)
SPAM_AUTO_TRASH=false
SPAM_AUTO_SCORE=15

# --- Betrieb ---------------------------------------------------------------
SYNC_INTERVAL_MINUTES=30
# true = nichts verschieben, nichts abmelden, nur protokollieren
DRY_RUN=false

# Basic-Auth für die Weboberfläche
UI_USER=sebastian
UI_PASSWORD=bitte-ein-langes-passwort
LOG_LEVEL=INFO
